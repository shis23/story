{
  "name": "storyforge-frontend",
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test \"tests/*.test.mjs\" \"tests/stores/*.test.mjs\" \"tests/composables/*.test.mjs\"",
    "test:ui": "vitest run",
    "test:mobile-chrome": "playwright test -c playwright.mobile-chrome.config.mjs",
    "test:all": "npm test && npm run test:ui",
    "smoke:ui": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/run-ui-smoke.ps1",
    "test:csp": "playwright test -c playwright.csp.config.mjs",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/noto-serif-sc": "^5.2.8",
    "@headlessui/vue": "^1.7.23",
    "@lucide/vue": "^1.41.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "dompurify": "^3.4.10",
    "pinia": "^3.0.4",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.10.6",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
