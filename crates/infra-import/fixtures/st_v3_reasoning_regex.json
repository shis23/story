    "character_book": {
      "name": "Reasoning Book",
      "description": "book metadata",
      "scan_depth": 5,
      "extensions": { "book_plugin": { "enabled": true } },
      "entries": [
        {
          "id": 1,
          "keys": ["think", "reasoning"],
          "content": "sanitized reasoning lore",
          "selective": true,
          "selective_logic": 1,
          "position": "after_char",
          "order": 1,
          "depth": 3
        }
      ]
    }
