      "regex_scripts": [
        {
          "id": "reasoning-strip",
          "scriptName": "Reasoning strip",
          "findRegex": "/<think>[\\s\\S]*?<\\/think>/g",
          "replaceString": "",
          "placement": [6],
          "disabled": false,
          "markdownOnly": false,
          "promptOnly": false,
          "minDepth": 1,
          "maxDepth": 8
        },
        {
          "id": "input-rewrite",
          "scriptName": "Input rewrite",
          "findRegex": "/foo/g",
          "replaceString": "bar",
          "placement": [1],
          "disabled": false,
          "promptOnly": true,
          "markdownOnly": false,
          "minDepth": 0,
          "maxDepth": 0
        },
        {
          "id": "output-display",
          "scriptName": "Output display",
          "findRegex": "/<img[^>]*>/gi",
          "replaceString": "[image]",
          "placement": [2],
          "disabled": false,
          "markdownOnly": true,
          "promptOnly": false
        }
      ],
      "fav": true,
      "assets": {
        "default": "<div class=\"display\">sanitized display asset</div>"
