    "personality": "deterministic",
    "scenario": "compat lab",
    "first_mes": "Primary greeting.",
    "mes_example": "<START>\n{{user}}: hi\n{{char}}: hello",
    "system_prompt": "system",
    "post_history_instructions": "phi",
    "tags": ["fixture", "reasoning", "regex"],
    "creator": "StoryForge",
